# FOM-Sports environment configuration (example)
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. `.env.local` is gitignored.
#
# ---------------------------------------------------------------------------
# Challonge Tournament API (server-only, never expose to the browser)
# ---------------------------------------------------------------------------
# Used by the TOURN-001 tournament integration
# (lib/integrations/tournament/providers/challonge.ts) and by the isolated POC
# (lib/integrations/challonge-poc/). Obtain/generate this from your Challonge
# account API settings. Never NEXT_PUBLIC_, never logged.
CHALLONGE_API_KEY=